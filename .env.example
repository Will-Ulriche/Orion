VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
# Secret JWT Supabase (Settings -> API -> JWT Secret) pour la vérification cryptographique des jetons (SEC-02)
SUPABASE_JWT_SECRET=votre-secret-jwt-supabase

# ── Scripts de seed (scripts/seed) ───────────────────────────
# Mots de passe des comptes de démonstration créés dans le cloud.
# Ils ne sont jamais versionnés : renseignez-les ici (ce fichier est ignoré par git).
SEED_PW_SAINT_LOUIS_SECRETARY=changez-ce-mot-de-passe
SEED_PW_SAINT_LOUIS_COMPTABLE=changez-ce-mot-de-passe
SEED_PW_SAINT_LOUIS_PROF_KOSSI=changez-ce-mot-de-passe
SEED_PW_SAINT_LOUIS_PROF_AFI=changez-ce-mot-de-passe
SEED_PW_AGORA_DIRECTION=changez-ce-mot-de-passe
SEED_PW_AGORA_SECRETARY=changez-ce-mot-de-passe
SEED_PW_NDL_DIRECTION=changez-ce-mot-de-passe
SEED_PW_NDL_SECRETARY=changez-ce-mot-de-passe
